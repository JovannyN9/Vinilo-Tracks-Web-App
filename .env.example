# Copia este archivo como .env y llena tus datos

# --- Discogs ---
# Lo sacas en: https://www.discogs.com/settings/developers  → "Generate new token"
DISCOGS_TOKEN=pega_tu_token_aqui

# --- Servidor ---
PORT=3000
# 0 = sin límite de año (todas las épocas). Pon 2010 si solo quieres de 2010 en adelante.
ANIO_MINIMO=0

# --- Login (Supabase) ---
# Supabase → tu proyecto → Project Settings → API
# Si los dejas vacíos, la página funciona igual pero sin login (la wishlist se queda en el navegador).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- SEO ---
# Tu dominio (sin / al final). Se usa en el sitemap, la URL canónica y las vistas previas al compartir.
SITE_URL=https://vinilotracks.com
# Opcional: tus redes separadas por coma (ayuda a que Google relacione la marca)
# REDES=https://www.instagram.com/vinilotracks,https://open.spotify.com/user/...
